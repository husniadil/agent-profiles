{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Profiles",
  "version": "0.3.0",
  "identifier": "com.husniadil.agent-profiles",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Agent Profiles",
        "width": 590,
        "height": 555,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
